# Copy to .env and fill in, then `source .env` before terraform commands.
# .env is gitignored; .env.example is safe to commit.
export TF_VAR_my_ip="203.0.113.4/32"    # your public IP /32  (curl -s ifconfig.me)
export TF_VAR_admin_password="CHANGE-ME" # RDP password: 12+ chars, upper/lower/digit/symbol
